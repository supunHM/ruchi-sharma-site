---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout
  title="Writing"
  description="Articles and essays by Ruchi Sharma."
  breadcrumbs={[{ name: 'Writing', path: '/writing/' }]}
>
  <section class="page">
    <p class="label">Beyond advertising</p>
    <h1>Writing</h1>
    {
      posts.length === 0 ? (
        <EmptyState message="The first articles are on their way." />
      ) : (
        <ul class="list">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <span class="t">{p.data.title}</span>
                <span class="d">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style is:global>
  .page { padding-block: clamp(48px, 7vw, 96px); }
  .page h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: 10px 0 36px; }
  .list { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
  .list li { border-bottom: 1px solid var(--line); }
  .list a { display: grid; gap: 4px; padding: 22px 0; text-decoration: none; color: inherit; }
  .list a:hover .t { color: var(--accent); }
  .list time { font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .list .t { font-family: var(--font-display); font-weight: 700; font-size: 1.45rem; letter-spacing: -.01em; }
  .list .d { color: var(--muted); }
</style>

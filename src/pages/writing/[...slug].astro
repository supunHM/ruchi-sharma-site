---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, site } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const origin = Astro.site!;
const url = absoluteUrl(`/writing/${post.id}/`, origin);
const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  breadcrumbs={[
    { name: 'Writing', path: '/writing/' },
    { name: post.data.title, path: `/writing/${post.id}/` },
  ]}
  jsonLd={[
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      mainEntityOfPage: url,
      author: { '@type': 'Person', name: site.name, url: origin.toString() },
    },
  ]}
>
  <article class="page">
    <p class="label"><a href="/writing/">← Writing</a></p>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
    {post.data.cover && <Image class="cover" src={post.data.cover} alt={post.data.coverAlt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 800px, 100vw" priority />}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .page { padding-block: clamp(48px, 7vw, 96px); }
  .label a { text-decoration: none; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 14px 0 10px; max-width: 18em; }
  time { font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .cover { width: 100%; max-width: 50rem; height: auto; margin-block: 32px; border-radius: var(--r); }
  .prose { margin-top: 32px; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="page">
    <p class="label">404</p>
    <h1>This page does not exist.</h1>
    <a class="btn" href="/">Back to the home page</a>
  </section>
</BaseLayout>

<style>
  .page { padding-block: clamp(64px, 10vw, 140px); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 10px 0 26px; max-width: 14em; }
</style>

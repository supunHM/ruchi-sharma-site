---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portraitLight from '../assets/hero/portrait-light.webp';
import portraitDark from '../assets/hero/portrait-dark.webp';
import careerData from '../data/career.json';
import { site } from '../utils/site';

const work = await getCollection('work');
const { hero } = site;
const stats = [
  { value: String(careerData.jobs.length), label: hero.statLabels[0] },
  { value: hero.markets, label: hero.statLabels[1] },
  { value: String(work.length), label: hero.statLabels[2] },
];
const sizes = '(min-width: 861px) 760px, 100vw';
---

<section class="hero" aria-labelledby="headline">
  <figure class="hero-img">
    <Image
      class="hero-light"
      src={portraitLight}
      alt="Portrait of Ruchi Sharma smiling"
      widths={[640, 960, 1400]}
      {sizes}
      priority
    />
    <Image
      class="hero-dark"
      src={portraitDark}
      alt="Portrait of Ruchi Sharma smiling, lit with a warm amber rim light against a black background"
      widths={[640, 960, 1400]}
      {sizes}
      loading="lazy"
    />
  </figure>

  <div class="hero-copy">
    <p class="pill glass rise" style="--i:0"><i aria-hidden="true"></i>{hero.pill}</p>
    <h1 id="headline" class="rise" style="--i:1">
      {hero.headlineStart} <em class="em">{hero.headlineEmphasis}</em>.
    </h1>
    <div class="actions rise" style="--i:2">
      <a class="btn" href="#work">{hero.cta}</a>
      <a class="btn-ghost glass" href="#contact">Let’s talk</a>
    </div>
  </div>

  <ul class="stats rise" style="--i:3">
    {
      stats.map((s) => (
        <li class="glass">
          <b>{s.value}</b>
          <span>{s.label}</span>
        </li>
      ))
    }
  </ul>

  <p class="tag glass rise" style="--i:4">
    <strong>{site.name}</strong>
    <span>{site.roles.slice(0, 2).join(' · ')}</span>
  </p>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--hero-bg);
    min-height: clamp(520px, 46vw, 600px);
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 24px;
    padding: clamp(28px, 5vw, 64px);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
  }
  .hero-img :global(img) {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    max-width: none;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    mask-image:
      linear-gradient(to right, transparent 0, #000 30%, #000 96%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 8%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  .hero-dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .hero-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .hero-dark {
    display: block;
  }
  .hero-copy {
    align-self: center;
    max-width: 29rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 6px 11px;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--muted);
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mark);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--mark) 25%, transparent);
  }
  h1 {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    line-height: 1.1;
    max-width: 15em;
    margin: 22px 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stats li {
    padding: 12px 14px;
    width: 132px;
  }
  .stats b {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.1;
    color: var(--fg);
  }
  .stats span {
    display: block;
    margin-top: 3px;
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--muted);
  }
  .tag {
    position: absolute;
    right: clamp(18px, 2.4vw, 30px);
    bottom: clamp(18px, 2.4vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    text-align: right;
  }
  .tag strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }
  .tag span {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes zoom-in {
      from {
        opacity: 0;
        transform: scale(1.04);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .hero-img :global(img) {
      animation: zoom-in 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @media (max-width: 860px) {
    .hero {
      display: block;
      padding: 0;
      min-height: 0;
    }
    .hero-img {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 4 / 3.5;
    }
    .hero-img :global(img) {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-position: 56% 18%;
      mask-image: linear-gradient(to bottom, #000 66%, transparent 100%);
      mask-composite: add;
      -webkit-mask-composite: source-over;
    }
    .hero-copy {
      position: relative;
      max-width: none;
      padding: 0 22px;
      margin-top: -34px;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      padding: 20px 14px 18px;
    }
    .stats li {
      width: auto;
      min-width: 0;
      padding: 10px 12px;
    }
    .stats b {
      font-size: 1.2rem;
    }
    .tag {
      display: none;
    }
  }
</style>

---
import { site } from '../utils/site';
const { contact } = site;
---

<section class="cta" id="contact" aria-labelledby="talk-h">
  <div>
    <h2 id="talk-h">{contact.heading}</h2>
    <p class="sentence">{contact.sentence}</p>
    <div class="btn-row">
      <a class="btn" href={contact.cvUrl} target="_blank" rel="noopener noreferrer">Download CV ↗</a>
    </div>
  </div>
  <div>
    <ul class="contacts">
      <li>
        <div><span class="k">Email</span><a class="v" href={`mailto:${contact.email}`}>{contact.email}</a></div>
        <button class="copy chip" type="button" data-copy={contact.email}>Copy</button>
      </li>
      <li>
        <div><span class="k">Phone</span><a class="v" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></div>
        <button class="copy chip" type="button" data-copy={contact.phone}>Copy</button>
      </li>
    </ul>
    <div class="socials">
      {contact.socials.map((s) => <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px clamp(32px, 6vw, 80px);
    padding: clamp(32px, 5vw, 56px);
    margin-block: clamp(40px, 5vw, 64px);
    border-radius: var(--r);
    background: var(--cta-bg);
    color: var(--cta-fg);
  }
  h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
  }
  .sentence {
    margin-top: 12px;
    opacity: 0.75;
    max-width: 22em;
  }
  .btn-row {
    margin-top: 26px;
  }
  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contacts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .k {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .v {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
    color: inherit;
    overflow-wrap: anywhere;
  }
  .copy {
    color: var(--cta-fg);
    border-color: rgb(255 255 255 / 0.25);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 22px;
  }
  .socials a {
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.8;
  }
  .socials a:hover {
    opacity: 1;
    color: var(--mark);
  }
  @media (max-width: 760px) {
    .cta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy'), 1600);
      } catch {
        b.textContent = 'Press Ctrl+C';
      }
    }),
  );
</script>

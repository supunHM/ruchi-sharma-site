---
import { getCollection } from 'astro:content';

const [writing, screenplays] = await Promise.all([
  getCollection('writing', ({ data }) => !data.draft),
  getCollection('screenplays', ({ data }) => !data.draft),
]);
const count = (n: number, one: string) => (n ? `${n} ${one}${n > 1 ? 's' : ''}` : 'Coming soon');

const cards = [
  { idx: '01', title: 'Writing', desc: 'Articles and blog posts.', href: '/writing/', tag: count(writing.length, 'article') },
  { idx: '02', title: 'Screenplays', desc: 'Short films and features.', href: '/screenplays/', tag: count(screenplays.length, 'screenplay') },
  { idx: '03', title: 'Author', desc: 'A home for the book.', href: '/author/', tag: 'Coming soon' },
];
---

<section class="split" id="creative" aria-labelledby="creative-h">
  <div>
    <h2 id="creative-h">Beyond advertising</h2>
    <p class="note">Writing, screenplays and books.</p>
  </div>
  <ul class="tri">
    {
      cards.map((c) => (
        <li class="reveal">
          <a class="glass" href={c.href}>
            <span class="idx" aria-hidden="true">{c.idx}</span>
            <span class="body">
              <span class="t">{c.title}</span>
              <span class="d">{c.desc}</span>
            </span>
            <span class="tag">{c.tag}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tri {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }
  a:hover {
    border-color: var(--accent);
  }
  .idx {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--mark);
  }
  .t {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }
  .d {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>

---
import { site } from '../utils/site';
---

<section class="split" id="about" aria-labelledby="about-h">
  <div><h2 id="about-h">About</h2></div>
  <div class="beats">
    {
      site.about.map((b) => (
        <div class="beat reveal">
          <p class="label">{b.label}</p>
          <p class:list={{ big: b.big }}>{b.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .beats {
    display: grid;
    gap: 34px;
    max-width: 40rem;
  }
  .beat p:last-child {
    margin-top: 8px;
  }
  .big {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
</style>

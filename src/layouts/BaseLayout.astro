---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { allowIndexing, absoluteUrl, site, socialUrls } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of an image in /public to use for sharing. */
  image?: string;
  /** "website" for pages, "article" for posts. */
  type?: 'website' | 'article';
  /** Page-specific structured data, added next to the site-wide Person and WebSite data. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail after "Home". */
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
  publishedTime?: Date;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  type = 'website',
  jsonLd = [],
  breadcrumbs = [],
  noindex = false,
  publishedTime,
} = Astro.props;

const origin = Astro.site ?? new URL('https://ruchisharma.com');
const canonical = absoluteUrl(Astro.url.pathname, origin);
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.jobTitle}`;
const imageUrl = absoluteUrl(image, origin);
const robots = allowIndexing && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';

const person = {
  '@type': 'Person',
  '@id': absoluteUrl('/#person', origin),
  name: site.name,
  jobTitle: site.jobTitle,
  description: site.description,
  url: absoluteUrl('/', origin),
  image: absoluteUrl('/og-default.png', origin),
  worksFor: { '@type': 'Organization', name: site.org },
  homeLocation: { '@type': 'Place', name: site.location },
  sameAs: socialUrls,
  knowsAbout: ['Brand storytelling', 'Creative direction', 'Copywriting', 'Advertising', 'Branding'],
};
const websiteLd = {
  '@type': 'WebSite',
  '@id': absoluteUrl('/#website', origin),
  url: absoluteUrl('/', origin),
  name: site.name,
  inLanguage: 'en',
  publisher: { '@id': person['@id'] },
};
const graph: Record<string, unknown>[] = [person, websiteLd, ...jsonLd];
if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: absoluteUrl(b.path, origin),
    })),
  });
}
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0b09" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/rss.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={structuredData} />

    <!-- Apply the saved theme before first paint so there is no flash. Light is the default. -->
    <script is:inline>
      try {
        if (localStorage.getItem('rs-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
